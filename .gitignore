# ---- 数据（体积大，勿提交原始产品）----
data/raw/**
data/processed/**

# ---- Level-0 工具包自身可能生成的输出（我们用 data/processed 代替）----
src/imaging/sentinel_l0_toolkit/outputs/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- MATLAB ----
*.asv
*.m~
*.mat
# 保留必要的脚本，忽略大体积中间产物
src/imaging/private/
# 运行日记含本机绝对路径/耗时，仅本地留存作实跑凭证
*_run_diary.txt

# ---- 第三方克隆（自带 .git，勿纳入本仓库）----
third_party/

# ---- 模型权重（体积大，按需用 Git LFS 或另行管理）----
models/*.pt
models/*.pth
models/*.ckpt

# ---- 结果与缓存 ----
results/figures/*
results/metrics/*
!results/figures/.gitkeep
!results/metrics/.gitkeep
*.log

# ---- 编辑器/系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- 环境 ----
.env

# ---- 本地智能体工作态（非项目交付物，含私人记忆/自动化）----
# 注意：早期 init 提交曾误跟踪 .workbuddy/memory/*.md，已用 git rm --cached 取消跟踪；
#       磁盘文件保留不动，仅不纳入版本控制、不上传。请勿再用 -f 强行 add。
.workbuddy/
**/.workbuddy/
